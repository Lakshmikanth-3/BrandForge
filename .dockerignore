# .dockerignore patterns are anchored at the context root, unlike .gitignore, so a bare
# "*.tsbuildinfo" or "dist" only matches at the top level. Nested packages need "**/".
**/node_modules
**/dist
**/*.tsbuildinfo
.git
.env
.env.*
!.env.example
data
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.claude
