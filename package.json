{
  "name": "sentry402",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sentry402 \u2014 agentic x402 bridge and trust layer on Algorand",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @sentry402/api",
    "build": "tsc --build && npm run build:web",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "accounts:create": "tsx scripts/create-accounts.ts",
    "accounts:check": "tsx scripts/check-accounts.ts",
    "dev:web": "npm run dev -w @sentry402/web",
    "build:web": "npm run build -w @sentry402/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}