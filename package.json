{
  "name": "sentry402",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sentry402 \u2014 agentic x402 bridge and trust layer on Algorand",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @sentry402/api",
    "build": "tsc --build && npm run build:web",
    "typecheck": "tsc --build --force && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run && npm run test:web",
    "test:watch": "vitest",
    "accounts:create": "tsx scripts/create-accounts.ts",
    "accounts:check": "tsx scripts/check-accounts.ts",
    "dev:web": "npm run dev -w @sentry402/web",
    "build:web": "npm run build -w @sentry402/web",
    "catalog:ingest": "tsx scripts/ingest.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "test:web": "npm run test -w @sentry402/web",
    "accounts:optin": "tsx scripts/optin-accounts.ts",
    "prober": "tsx scripts/prober.ts",
    "receipts:sync": "tsx scripts/sync-receipts.ts",
    "settle:inbound": "tsx scripts/settle-inbound.ts",
    "check:endpoint": "tsx scripts/check-endpoint.ts",
    "kill-switch": "tsx scripts/kill-switch.ts",
    "trust:export": "tsx scripts/export-seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lakshmikanth-3/Sentry402.git"
  }
}