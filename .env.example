# ── Single source of truth. Everything derives from NETWORK. ──
NETWORK=testnet                 # testnet | mainnet

# Public base URL of this deployment (Railway domain now; custom domain at cutover)
PUBLIC_BASE_URL=http://localhost:4021
PORT=4021

# GoPlausible facilitator
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Merchant account — RECEIVES. Address only; no key needed on the server.
# MAINNET: once set and settled against, NEVER rotate.
MERCHANT_ADDRESS=

# Payer account — SPENDS on behalf of agents. Needs the mnemonic to sign.
# 25 words, space separated. Never commit. Never log.
PAYER_ADDRESS=
PAYER_MNEMONIC=

# Chain reads (defaults are AlgoNode free tier; overridable)
ALGOD_URL=
INDEXER_URL=

# Build identity (Railway injects RAILWAY_GIT_COMMIT_SHA automatically)
BUILD_SHA=dev
